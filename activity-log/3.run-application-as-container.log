➜  app git:(main) cd ../docker-compose 
➜  docker-compose cp docker-compose.yml app.yml
➜  docker-compose # Modifying the app.yml, it only contains springboot application
➜  docker-compose cat app.yml 
services:
  springbootdemo:
    image: springbootdemo
    container_name: springbootdemo
    environment:
      - _JAVA_OPTIONS=-Xmx512m -Xms256m
      - SPRING_PROFILES_ACTIVE=prod,api-docs
      - MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=true
      - SPRING_DATASOURCE_URL=jdbc:postgresql://postgresql:5432/SpringBootDemo
      - SPRING_LIQUIBASE_URL=jdbc:postgresql://postgresql:5432/SpringBootDemo
      - JHIPSTER_LOGGING_LOGSTASH_ENABLED=false
      - MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true
    ports:
      - 8080:8080
    healthcheck:
      test:
        - CMD
        - curl
        - -f
        - http://localhost:8080/management/health
      interval: 5s
      timeout: 5s
      retries: 40
    networks: ["springbootdemo"]
networks:
  springbootdemo:
    external: true%                                                                                                                                                      ➜  docker-compose cat postgres.yml 
services:
  postgresql:
    image: postgres:16.4
    container_name: postgresql
    ports: ["5432:5432"]
    volumes:
      - ./tmp/postgresql/data/:/var/lib/postgresql/data/
    environment:
      - POSTGRES_USER=SpringBootDemo
      - POSTGRES_PASSWORD=
      - POSTGRES_HOST_AUTH_METHOD=trust
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U $${POSTGRES_USER}
      interval: 5s
      timeout: 5s
      retries: 10
    networks: ["springbootdemo"]
networks:
  springbootdemo:
